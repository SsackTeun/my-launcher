{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "도구함",
  "version": "0.1.0",
  "identifier": "local.jaeyeong.launcher.windows",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "도구함",
        "width": 420,
        "height": 640,
        "minWidth": 300,
        "minHeight": 200,
        "transparent": true,
        "windowEffects": { "effects": ["acrylic"] }
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": { "installMode": "currentUser" }
    }
  }
}
